rules_version = '2';

// Evolora file storage rules (system-design 4.3).
// Lesson images are uploaded only by the loading program (D-33, D-49).
// Anyone signed in can see them, if they know the exact file address: lesson images
// are shared openly (CC BY-SA, REQ-1.1) and hold no student data. The lessons
// themselves, which list these addresses, are visible only to the classes they
// are open to (database rules), so strangers have no way to find them (REQ-10.1).
service firebase.storage {
  match /b/{bucket}/o {
    function isLoader() {
      return request.auth != null && request.auth.uid == 'evolora-loader';
    }

    match /lessons/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isLoader();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
