rules_version = '2';

// Evolora file storage rules (system-design 4.3).
// Lesson images are uploaded only by the loading program (D-33, D-49).
// Anyone signed in can see them, if they know the exact file address: lesson images
// are shared openly (CC BY-SA, REQ-1.1) and hold no student data. The lessons
// themselves, which list these addresses, are visible only to the classes they
// are open to (database rules), so strangers have no way to find them (REQ-10.1).
service firebase.storage {
  match /b/{bucket}/o {
    function isLoader() {
      return request.auth != null && request.auth.uid == 'evolora-loader';
    }

    match /lessons/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isLoader();
    }

    // Recordings (REQ-6.6, D-67): a student records into their own folder, which only they can
    // open. When the answer is sent, the checking service attaches a private link to it, which
    // only the student and the teachers of their class can see. Teachers' audio comments are
    // saved by the checking service (in comments/), so no one's browser writes there.
    match /recordings/{uid}/{lessonId}/{questionId}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('audio/.*');
      allow delete: if isLoader();
    }
    match /comments/{allPaths=**} {
      allow delete: if isLoader();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
