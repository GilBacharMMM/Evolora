rules_version = '2';

// Evolora database rules (system-design section 4.3, REQ-3.4, REQ-10.1, REQ-10.3).
// They apply even if someone tries to get around the website.
//
// Stage 1:
// - Only the loading program (the "loader" account, run by Claude) adds or changes
//   lessons, courses, classes, memberships and staff (D-33, D-47) from a browser or program.
//   Teachers' and students' class actions (create a class, join, new code, remove a student,
//   give lessons) go through the class service in the cloud, which these rules don't limit.
// - A person's role comes from the staff list (staff/{email}); everyone else is a student (REQ-2.2).
// - Students read only their own record, their own classes, and lessons and courses
//   opened to one of their classes. Never the correct answers (D-17).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The loading program's own account (test project). Fixed account ID, set by Claude.
    function isLoader() {
      return signedIn() && request.auth.uid == 'evolora-loader';
    }

    function verifiedEmail() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function staffDoc() {
      return /databases/$(database)/documents/staff/$(request.auth.token.email.lower());
    }

    function isStaff() {
      return verifiedEmail() && exists(staffDoc());
    }

    function isTeacher() {
      return isStaff() && get(staffDoc()).data.role in ['teacher', 'admin'];
    }

    function isAdmin() {
      return isStaff() && get(staffDoc()).data.role == 'admin';
    }

    function myClassIds() {
      let m = /databases/$(database)/documents/memberships/$(request.auth.uid);
      return exists(m) ? get(m).data.classIds : [];
    }

    function inAnyOf(classIds) {
      return signedIn() && myClassIds().hasAny(classIds);
    }

    // People
    match /staff/{email} {
      allow read: if isLoader() || isAdmin()
        || (verifiedEmail() && email == request.auth.token.email.lower());
      allow write: if isLoader();
    }

    match /users/{uid} {
      allow read: if isLoader() || isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isLoader() || (signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'language', 'createdAt', 'lastSignIn']));
      allow delete: if isLoader();
    }

    match /memberships/{uid} {
      allow read: if isLoader() || (signedIn() && request.auth.uid == uid);
      allow write: if isLoader();
    }

    // Classes
    match /classes/{classId} {
      allow read: if isLoader()
        || (isTeacher() && request.auth.uid in resource.data.teacherIds)
        || (signedIn() && classId in myClassIds());
      allow write: if isLoader();

      function teachesThisClass() {
        return isTeacher() && request.auth.uid in
          get(/databases/$(database)/documents/classes/$(classId)).data.teacherIds;
      }

      // The class list: only the class's teachers (REQ-5.4)
      match /students/{uid} {
        allow read: if isLoader() || teachesThisClass();
        allow write: if isLoader();
      }

      // Secret student levels: never the student (REQ-5.18)
      match /levels/{uid} {
        allow read: if isLoader() || teachesThisClass();
        allow write: if isLoader();
      }

      // What the class was given (REQ-5.7). Written only by the class service (system-design 2.6).
      // A student reads only whole-class assignments and those given to them.
      match /assignments/{assignmentId} {
        allow read: if isLoader() || teachesThisClass()
          || (signedIn() && classId in myClassIds()
              && (resource.data.everyone == true || request.auth.uid in resource.data.studentIds));
        allow write: if isLoader();
      }

      // Private teacher notes about students: never the student (REQ-5.28).
      match /notes/{noteId} {
        allow read: if isLoader() || teachesThisClass();
        allow write: if isLoader();
      }

      // Lessons the teacher opened early (REQ-5.20), read the same way as assignments.
      match /openings/{openingId} {
        allow read: if isLoader() || teachesThisClass()
          || (signedIn() && classId in myClassIds()
              && (resource.data.everyone == true || request.auth.uid in resource.data.studentIds));
        allow write: if isLoader();
      }
    }

    // Messages (REQ-5.16, 10.2): only the student and the teachers of that class. Written only by
    // the class service.
    function inConversation(conversation) {
      return signedIn() && (
        (conversation.uid == request.auth.uid && conversation.classId in myClassIds())
        || (isTeacher() && request.auth.uid in
            get(/databases/$(database)/documents/classes/$(conversation.classId)).data.teacherIds));
    }
    match /conversations/{conversationId} {
      allow read: if isLoader() || inConversation(resource.data);
      allow write: if isLoader();
      match /messages/{messageId} {
        allow read: if isLoader()
          || inConversation(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow write: if isLoader();
      }
    }

    // Class codes and wrong-code counts (REQ-5.2): only the class service uses them.
    match /classCodes/{code} {
      allow read, write: if isLoader();
    }
    match /joinAttempts/{uid} {
      allow read, write: if isLoader();
    }

    // Lessons: details, versions, and the protected answers
    match /lessons/{lessonId} {
      function lessonOpenToMe() {
        return isTeacher() || isLoader()
          || inAnyOf(get(/databases/$(database)/documents/lessons/$(lessonId)).data.classIds);
      }

      allow read: if isTeacher() || isLoader() || inAnyOf(resource.data.classIds);
      allow write: if isLoader();

      match /versions/{version} {
        allow read: if lessonOpenToMe();
        allow write: if isLoader();

        // Correct answers, hints, solutions, check-again questions and grading
        // instructions. Never readable by students (D-17).
        match /secret/{doc} {
          allow read: if isLoader() || isTeacher();
          allow write: if isLoader();
        }
      }
    }

    // Courses
    match /courses/{courseId} {
      allow read: if isTeacher() || isLoader() || inAnyOf(resource.data.classIds);
      allow write: if isLoader();
    }

    // Student work: answers, attempts, scores and place in the lesson (REQ-6.2, 6.3).
    // Written only by the checking service, never by students (system-design 4.3).
    // Read by the student, and by the teachers of the classes the work belongs to.
    function teachesAnyOf(classIds) {
      return isTeacher() && classIds.size() > 0 && request.auth.uid in
        get(/databases/$(database)/documents/classes/$(classIds[0])).data.teacherIds;
    }

    match /progress/{id} {
      allow read: if isLoader()
        || (signedIn() && id.split('__')[0] == request.auth.uid)
        || teachesAnyOf(resource.data.get('classIds', []));
      allow write: if isLoader() && request.method == 'delete';
    }

    // Exam results (REQ-4.26): the student reads their own only after the teacher releases them;
    // the class's teachers always. Written only by the checking service.
    match /examResults/{id} {
      allow read: if isLoader()
        || (signedIn() && id.split('__')[0] == request.auth.uid && resource.data.released == true)
        || teachesAnyOf(resource.data.get('classIds', []));
      allow write: if isLoader();
    }

    // Red flags for teachers (REQ-4.17, 4.21, 1.3). Written only by the checking service.
    match /flags/{id} {
      allow read: if isLoader() || (isTeacher() && request.auth.uid in
        get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.teacherIds);
      allow delete: if isLoader();
    }

    // Anything not listed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
